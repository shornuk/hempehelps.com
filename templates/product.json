        "custom_liquid_zKWcGL": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{% comment %} Custom Variant Picker Cards {% endcomment %}\n\n<style>\n  .variant-cards-wrapper {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin: 16px 0;\n  }\n\n  .variant-card {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 14px 16px;\n    border: 2px solid #e5e7eb;\n    border-radius: 12px;\n    background: #fff;\n    box-shadow: 0 1px 4px rgba(0,0,0,0.06);\n    cursor: pointer;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n  }\n\n  .variant-card:hover {\n    border-color: #b0c4b1;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n  }\n\n  .variant-card.is-active {\n    border-color: #2d6a4f;\n    box-shadow: 0 2px 10px rgba(45,106,79,0.15);\n  }\n\n  .variant-card__image {\n    width: 56px;\n    height: 56px;\n    object-fit: contain;\n    border-radius: 6px;\n    flex-shrink: 0;\n  }\n\n  .variant-card__image-placeholder {\n    width: 56px;\n    height: 56px;\n    background: #f3f4f6;\n    border-radius: 6px;\n    flex-shrink: 0;\n  }\n\n  .variant-card__info {\n    flex: 1;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .variant-card__title {\n    font-size: 15px;\n    font-weight: 600;\n    color: #111;\n  }\n\n  .variant-card__badge {\n    background: #f5c842;\n    color: #1a1a1a;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    padding: 3px 10px;\n    border-radius: 20px;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .variant-card__pricing {\n    margin-left: auto;\n    text-align: right;\n    flex-shrink: 0;\n  }\n\n  .variant-card__price {\n    font-size: 17px;\n    font-weight: 700;\n    color: #111;\n  }\n\n  .variant-card__unit-price {\n    font-size: 12px;\n    color: #6b7280;\n    margin-top: 2px;\n  }\n\n  @media (max-width: 480px) {\n    .variant-card__price {\n      font-size: 15px;\n    }\n    .variant-card__title {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<div class=\"variant-cards-wrapper\" id=\"variant-cards-wrapper\">\n  {%- for variant in product.variants -%}\n    {%- assign unit_price_meta = variant.metafields.custom.unit_price | default: '' -%}\n    {%- assign is_popular_meta = variant.metafields.custom.most_popular | default: false -%}\n\n    <div\n      class=\"variant-card{% if forloop.first %} is-active{% endif %}\"\n      data-variant-id=\"{{ variant.id }}\"\n      data-variant-url=\"{{ product.url }}?variant={{ variant.id }}\"\n      role=\"button\"\n      tabindex=\"0\"\n      aria-label=\"Select {{ variant.title }}\"\n    >\n      {%- if variant.image -%}\n        <img\n          class=\"variant-card__image\"\n          src=\"{{ variant.image | image_url: width: 120 }}\"\n          alt=\"{{ variant.title }}\"\n          loading=\"lazy\"\n          width=\"56\"\n          height=\"56\"\n        >\n      {%- elsif product.featured_image -%}\n        <img\n          class=\"variant-card__image\"\n          src=\"{{ product.featured_image | image_url: width: 120 }}\"\n          alt=\"{{ variant.title }}\"\n          loading=\"lazy\"\n          width=\"56\"\n          height=\"56\"\n        >\n      {%- else -%}\n        <div class=\"variant-card__image-placeholder\"></div>\n      {%- endif -%}\n\n      <div class=\"variant-card__info\">\n        <span class=\"variant-card__title\">{{ variant.title }}</span>\n        {%- if is_popular_meta == 'true' or is_popular_meta == true -%}\n          <span class=\"variant-card__badge\">Most Popular</span>\n        {%- endif -%}\n      </div>\n\n      <div class=\"variant-card__pricing\">\n        <div class=\"variant-card__price\">{{ variant.price | money }}</div>\n        {%- if unit_price_meta != '' -%}\n          <div class=\"variant-card__unit-price\">{{ unit_price_meta }}</div>\n        {%- endif -%}\n      </div>\n    </div>\n  {%- endfor -%}\n</div>\n\n<script>\n  (function() {\n    const wrapper = document.getElementById('variant-cards-wrapper');\n    if (!wrapper) return;\n\n    const cards = wrapper.querySelectorAll('.variant-card');\n\n    function selectVariant(card) {\n      // Update active state\n      cards.forEach(c => c.classList.remove('is-active'));\n      card.classList.add('is-active');\n\n      const variantId = card.dataset.variantId;\n\n      // Update URL without reload\n      const url = new URL(window.location.href);\n      url.searchParams.set('variant', variantId);\n      window.history.replaceState({}, '', url.toString());\n\n      // Update the native variant select/input FIRST\n      const nativeSelect = document.querySelector('select[name=\"id\"], input[name=\"id\"]');\n      if (nativeSelect) {\n        nativeSelect.value = variantId;\n        nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n\n      // Dispatch variant change event for themes that listen to it\n      document.dispatchEvent(new CustomEvent('variant:changed', {\n        detail: { variantId: parseInt(variantId) }\n      }));\n\n      // Fetch updated section HTML for price/button state only\n      fetch(`${card.dataset.variantUrl}&section_id={{ section.id }}`)\n        .then(res => res.text())\n        .then(html => {\n          const doc = new DOMParser().parseFromString(html, 'text/html');\n\n          // Update price display only\n          const newPrice = doc.querySelector('.price, [data-price], .product__price');\n          const currentPrice = document.querySelector('.price, [data-price], .product__price');\n          if (newPrice && currentPrice) currentPrice.innerHTML = newPrice.innerHTML;\n\n          // Update add to cart button state only (disabled/text), not the form itself\n          const newBtn = doc.querySelector('[name=\"add\"], .product-form__submit');\n          const currentBtn = document.querySelector('[name=\"add\"], .product-form__submit');\n          if (newBtn && currentBtn) {\n            currentBtn.disabled = newBtn.disabled;\n            currentBtn.textContent = newBtn.textContent;\n          }\n\n          // Re-apply the correct variant ID after fetch (in case the fetch overwrote it)\n          const nativeSel = document.querySelector('select[name=\"id\"], input[name=\"id\"]');\n          if (nativeSel && nativeSel.value !== variantId) {\n            nativeSel.value = variantId;\n          }\n        })\n        .catch(() => {});\n    }\n\n    cards.forEach(card => {\n      card.addEventListener('click', () => selectVariant(card));\n      card.addEventListener('keydown', e => {\n        if (e.key === 'Enter' || e.key === ' ') {\n          e.preventDefault();\n          selectVariant(card);\n        }\n      });\n    });\n\n    // Sync with URL on load\n    const urlParams = new URLSearchParams(window.location.search);\n    const activeVariantId = urlParams.get('variant');\n    if (activeVariantId) {\n      const matchingCard = wrapper.querySelector(`[data-variant-id=\"${activeVariantId}\"]`);\n      if (matchingCard) {\n        cards.forEach(c => c.classList.remove('is-active'));\n        matchingCard.classList.add('is-active');\n      }\n    }\n\n    // Set initial variant on page load (no URL param = first variant)\n    const initialCard = wrapper.querySelector('.is-active');\n    if (initialCard) {\n      const variantId = initialCard.dataset.variantId;\n      const nativeSelect = document.querySelector('select[name=\"id\"], input[name=\"id\"]');\n      if (nativeSelect) {\n        nativeSelect.value = variantId;\n      }\n    }\n  })();\n</script>"
          }
