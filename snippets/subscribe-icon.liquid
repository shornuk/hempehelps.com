{% comment %}
  Line icons for the Subscribe & Save sections.

  Accepts:
  - icon: {String} check | tag | truck | calendar | shield | pause | skip | reschedule | refresh | cancel | snow | flame | arrow
  - class: {String} optional extra class

  Usage:
  {% render 'subscribe-icon', icon: 'truck' %}
{% endcomment %}

{%- capture attrs -%}
  class="subscribe__icon{% if class != blank %} {{ class }}{% endif %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
{%- endcapture -%}

{%- case icon -%}
  {%- when 'check' -%}
    <svg {{ attrs }}><path d="M20 6 9 17l-5-5"/></svg>
  {%- when 'tag' -%}
    <svg {{ attrs }}><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
  {%- when 'calendar' -%}
    <svg {{ attrs }}><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
  {%- when 'shield' -%}
    <svg {{ attrs }}><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'pause' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg>
  {%- when 'skip' -%}
    <svg {{ attrs }}><path d="m5 5 8 7-8 7V5Z"/><path d="M17 5v14"/></svg>
  {%- when 'reschedule' -%}
    <svg {{ attrs }}><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M12 14v3l2 1"/></svg>
  {%- when 'refresh' -%}
    <svg {{ attrs }}><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/></svg>
  {%- when 'cancel' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/></svg>
  {%- when 'snow' -%}
    <svg {{ attrs }}><path d="M12 2v20M4.9 7l14.2 10M4.9 17 19.1 7"/><path d="m9 4 3 2 3-2M9 20l3-2 3 2"/></svg>
  {%- when 'flame' -%}
    <svg {{ attrs }}><path d="M12 22c4 0 7-2.8 7-7 0-3.5-2.5-6.5-4-8-.3 2-1.5 3.5-3 4 .5-3-1-6.5-4-9 0 4-5 6.5-5 13 0 4.2 3 7 9 7Z"/></svg>
  {%- when 'arrow' -%}
    <svg {{ attrs }}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- endcase -%}
