{% comment %}
  Renders variant option values as selectable cards with image, price,
  unit price, and an optional badge (variant metafield: custom.badge).

  Only intended for single-option products — the picker gates on
  product.options.size == 1 before rendering this.

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - product_form_id: {String} Id of the associated product form.

  Usage:
  {% render 'product-variant-cards', product: product, option: option, product_form_id: product_form_id %}
{% endcomment %}

<fieldset class="js product-form__input product-form__input--cards">
  <legend class="form__label visually-hidden">{{ option.name }}</legend>

  {%- for value in option.values -%}
    {%- liquid
      # option.values items are strings on older themes and
      # product_option_value objects on newer ones — handle both.
      assign value_label = value.name | default: value

      case option.position
        when 1
          assign card_variant = product.variants | where: 'option1', value_label | first
        when 2
          assign card_variant = product.variants | where: 'option2', value_label | first
        when 3
          assign card_variant = product.variants | where: 'option3', value_label | first
      endcase

      assign sold_out = false
      if card_variant.available == false
        assign sold_out = true
      endif

      assign badge = card_variant.metafields.custom.badge | strip
    -%}

    {%- capture input_id -%}
      {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
    {%- endcapture -%}

    <input
      type="radio"
      id="{{ input_id }}"
      class="variant-card__radio{% if sold_out %} disabled{% endif %}"
      name="{{ option.name }}"
      value="{{ value_label | escape }}"
      form="{{ product_form_id }}"
      {% if option.selected_value == value %}
        checked
      {% endif %}
    >
    <label for="{{ input_id }}" class="variant-card{% if sold_out %} variant-card--sold-out{% endif %}">
      <span class="variant-card__media">
        {%- assign card_image = card_variant.featured_image | default: product.featured_image -%}
        {%- if card_image -%}
          <img
            src="{{ card_image | image_url: width: 160 }}"
            srcset="{{ card_image | image_url: width: 160 }} 1x, {{ card_image | image_url: width: 320 }} 2x"
            alt=""
            width="80"
            height="{{ 80 | divided_by: card_image.aspect_ratio | round }}"
            loading="lazy"
          >
        {%- endif -%}
      </span>

      <span class="variant-card__label">
        <span class="variant-card__title">{{ value_label }}</span>
        {%- if badge != blank -%}
          <span class="variant-card__badge">{{ badge }}</span>
        {%- endif -%}
        {%- if sold_out -%}
          <span class="variant-card__sold-out-text">{{ 'products.product.sold_out' | t }}</span>
        {%- endif -%}
      </span>

      <span class="variant-card__pricing">
        <span class="variant-card__price">{{ card_variant.price | money }}</span>
        {%- if card_variant.unit_price_measurement -%}
          <span class="variant-card__unit-price">
            {{ card_variant.unit_price | money }}
            <span aria-hidden="true">/</span>
            <span class="visually-hidden">{{ 'products.product.unit_price_separator' | t }}&nbsp;</span>
            {%- if card_variant.unit_price_measurement.reference_value != 1 -%}
              {{- card_variant.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{ card_variant.unit_price_measurement.reference_unit }}
          </span>
        {%- endif -%}
      </span>

      <span class="visually-hidden label-unavailable">
        {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
      </span>
    </label>
  {%- endfor -%}
</fieldset>
