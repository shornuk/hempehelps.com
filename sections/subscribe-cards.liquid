{{ 'section-subscribe.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign card_style = section.settings.card_style
  assign cards_columns = section.blocks.size | at_most: 5 | at_least: 1
-%}

<div
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
  class="subscribe subscribe-cards color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="subscribe__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="subscribe__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="subscribe__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="subscribe__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- if card_style == 'numbered' -%}
        <ol class="subscribe-cards__grid" style="--cards-columns: {{ cards_columns }};">
      {%- else -%}
        <ul class="subscribe-cards__grid" style="--cards-columns: {{ cards_columns }};">
      {%- endif -%}
      {%- for block in section.blocks -%}
        <li class="subscribe-card subscribe-card--{{ card_style }}" {{ block.shopify_attributes }}>
          {%- if card_style == 'numbered' -%}
            <span class="subscribe-card__number" aria-hidden="true">{{ forloop.index }}</span>
          {%- else -%}
            {% render 'subscribe-icon', icon: block.settings.icon %}
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="subscribe-card__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="subscribe-card__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if card_style == 'numbered' -%}
        </ol>
      {%- else -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Subscribe: cards",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "numbered", "label": "Numbered steps" },
        { "value": "icon", "label": "Icon cards" }
      ],
      "default": "numbered"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Set it up once. We'll handle the rest."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets buttons link here, e.g. \"how\" for #how"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Only shown with the \"Icon cards\" style",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Price tag" },
            { "value": "truck", "label": "Delivery" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "shield", "label": "Shield" },
            { "value": "pause", "label": "Pause" },
            { "value": "skip", "label": "Skip" },
            { "value": "reschedule", "label": "Reschedule" },
            { "value": "refresh", "label": "Change frequency" },
            { "value": "cancel", "label": "Cancel" },
            { "value": "snow", "label": "Ice" },
            { "value": "flame", "label": "Hot" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Short description.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscribe: cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
