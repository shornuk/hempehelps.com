{{ 'section-subscribe.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  if image_1 == blank and section.settings.fallback_product != blank
    assign image_1 = section.settings.fallback_product.featured_image
  endif
-%}

<div class="subscribe subscribe-hero color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="subscribe-hero__grid">
      <div class="subscribe-hero__content">
        {%- if section.settings.badge != blank -%}
          <p class="subscribe__pill">{{ section.settings.badge | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="subscribe-hero__title">{{ section.settings.heading | escape | newline_to_br }}</h1>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="subscribe-hero__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="subscribe__buttons">
            {%- if section.settings.button_label_1 != blank -%}
              <a href="{{ section.settings.button_link_1 | default: '#choose' }}" class="subscribe__btn subscribe__btn--primary">
                {{- section.settings.button_label_1 | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a href="{{ section.settings.button_link_2 | default: '#how' }}" class="subscribe__btn subscribe__btn--secondary">
                {{- section.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="subscribe-hero__bullets">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'subscribe-icon', icon: 'check' %}
                {{ block.settings.text | escape }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if image_1 != blank or image_2 != blank or request.design_mode -%}
        <div class="subscribe-hero__media">
          <span class="subscribe-hero__circle" aria-hidden="true"></span>
          {%- if image_1 != blank -%}
            {{
              image_1
              | image_url: width: 900
              | image_tag:
                class: 'subscribe-hero__img',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 990px) 25vw, 50vw',
                fetchpriority: 'high',
                loading: 'eager'
            }}
          {%- elsif request.design_mode -%}
            {{ 'product-1' | placeholder_svg_tag: 'subscribe-hero__img placeholder-svg' }}
          {%- endif -%}
          {%- if image_2 != blank -%}
            {{
              image_2
              | image_url: width: 600
              | image_tag:
                class: 'subscribe-hero__img subscribe-hero__img--secondary',
                widths: '200, 300, 450, 600',
                sizes: '(min-width: 990px) 18vw, 35vw',
                loading: 'eager'
            }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Subscribe: hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Subscribe & save 10%"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "Never run out\nof relief."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get your HEMPE Ice or Hot Muscle & Joint Gel delivered every 4 weeks, with 10% off every order. Pause, skip, reschedule or cancel whenever you like – you're always in control.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Start a subscription"
    },
    {
      "type": "text",
      "id": "button_link_1",
      "label": "Primary button link",
      "info": "URL or anchor, e.g. #choose",
      "default": "#choose"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "button_link_2",
      "label": "Secondary button link",
      "info": "URL or anchor, e.g. #how",
      "default": "#how"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main product image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary product image"
    },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Fallback product",
      "info": "Its featured image is used when no main image is set"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cancel anytime"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscribe: hero",
      "blocks": [
        { "type": "bullet", "settings": { "text": "10% off every delivery" } },
        { "type": "bullet", "settings": { "text": "Free UK delivery" } },
        { "type": "bullet", "settings": { "text": "Cancel anytime" } }
      ]
    }
  ]
}
{% endschema %}
