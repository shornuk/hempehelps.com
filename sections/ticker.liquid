{% style %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  @keyframes ticker-scroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-300px * {{ section.blocks.size }}));
    }
  }

  .ticker-container .ticker-tape {
    height: auto;
    margin: auto;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .ticker-container .ticker-tape:before,
  .ticker-container .ticker-tape:after {
    background: linear-gradient(to right, rgb(var(--color-background)) 0%, rgba(var(--color-background), 0) 100%);
    content: "";
    top: 0;
    bottom: 0;
    position: absolute;
    width: clamp(32px, 15vw, 200px);
    z-index: 2;
    pointer-events: none;
  }

  .ticker-container .ticker-tape:after {
    right: 0;
    transform: rotateZ(180deg);
  }

  .ticker-container .ticker-tape:before {
    left: 0;
  }

  .section-{{ section.id }}-padding .slide-track {
    animation: ticker-scroll-{{ section.id }} {{ section.blocks.size | times: 11 }}s linear infinite;
    display: flex;
    width: max-content;
  }

  .ticker-container div.slide {
    box-sizing: border-box;
    flex: 0 0 300px;
    width: 300px;
    padding: 0 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ticker-container div.slide img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 120px;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }}-padding .slide-track {
      animation: none;
    }
  }
{% endstyle %}

{%- liquid
  assign set_width = section.blocks.size | times: 300 | at_least: 300
  assign copies = 3840 | divided_by: set_width | plus: 2
-%}

<div class="">
  <div class="section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}>

    
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}
    

    <div class="ticker-container">
      <div class="ticker-tape">
        <div class="slide-track">
          {%- for i in (1..copies) -%}
            {%- for block in section.blocks -%}
              <div class="slide"{% if i > 1 %} aria-hidden="true"{% endif %}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag: loading: 'eager', sizes: '276px', widths: '276, 414, 552, 600'
                  }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ticker",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Ticker",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ticker",
      "blocks": [
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
