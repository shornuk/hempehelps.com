{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'section-sample-duo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.image_zoom == 'hover' -%}
  <script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign product_form_id = 'sample-duo-form-' | append: section.id
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign ingredients = section.settings.ingredients | newline_to_br | split: '<br />'
-%}

{%- capture icon_truck -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
{%- endcapture -%}
{%- capture icon_flame -%}
  <svg class="sample-duo__include-icon sample-duo__card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
{%- endcapture -%}
{%- capture icon_snow -%}
  <svg class="sample-duo__include-icon sample-duo__card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="2" x2="12" y2="22"></line><path d="m20 6-8 6-8-6"></path><path d="m4 18 8-6 8 6"></path><path d="m20 18-8-6-8 6"></path><path d="m4 6 8 6 8-6"></path></svg>
{%- endcapture -%}
{%- capture icon_check -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
{%- endcapture -%}
{%- capture icon_star -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg>
{%- endcapture -%}

<section
  id="MainProduct-{{ section.id }}"
  class="sample-duo section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
>
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col{% if product.media.size > 0 %} grid--2-col-tablet{% else %} product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {%- if product.media.size > 0 -%}
          {% render 'product-media-gallery', variant_images: variant_images %}
        {%- endif -%}
      </div>

      <div class="product__info-wrapper grid__item">
        <div class="sample-duo__buy" id="ProductInfo-{{ section.id }}">
      {%- if section.settings.dispatch_text != blank -%}
        <p class="sample-duo__dispatch">
          {{ icon_truck }}
          <span>{{ section.settings.dispatch_text }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.badge != blank -%}
        <p class="sample-duo__badge">{{ section.settings.badge }}</p>
      {%- endif -%}

      <h1 class="sample-duo__title">
        {{ section.settings.heading | default: product.title }}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="sample-duo__subhead">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.price_label != blank -%}
        <p class="sample-duo__price">{{ section.settings.price_label }}</p>
      {%- endif -%}

      <div class="sample-duo__includes">
        <div class="sample-duo__include sample-duo__include--hot">
          {{ icon_flame }}
          <p class="sample-duo__include-title">{{ section.settings.hot_title }}</p>
          <p class="sample-duo__include-meta">{{ section.settings.hot_meta }}</p>
        </div>
        <div class="sample-duo__include sample-duo__include--ice">
          {{ icon_snow }}
          <p class="sample-duo__include-title">{{ section.settings.ice_title }}</p>
          <p class="sample-duo__include-meta">{{ section.settings.ice_meta }}</p>
        </div>
      </div>

      <product-form class="sample-duo__form product-form" data-section-id="{{ section.id }}">
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>

        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}" disabled class="product-variant-id">
          <input type="hidden" name="quantity" value="1">

          <div class="product-form__buttons">
            <button
              id="ProductSubmitButton-{{ section.id }}"
              type="submit"
              name="add"
              class="sample-duo__submit product-form__submit button button--primary"
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              <span>
                {%- if variant.available -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              <div class="loading-overlay__spinner hidden">
                <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </button>
          </div>
        {%- endform -%}
      </product-form>

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <ul class="sample-duo__trust">
          {%- if section.settings.trust_1 != blank -%}
            <li>{{ icon_check }} {{ section.settings.trust_1 }}</li>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <li>{{ icon_check }} {{ section.settings.trust_2 }}</li>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <li>{{ icon_check }} {{ section.settings.trust_3 }}</li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="sample-duo__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}

      <div class="sample-duo__accordions">
        {%- if section.settings.accordion_usage != blank -%}
          <div class="product__accordion accordion">
            <details>
              <summary>
                <div class="summary__title">
                  {% render 'icon-accordion', icon: 'plant' %}
                  <h2 class="h4 accordion__title">Directions and usage</h2>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">{{ section.settings.accordion_usage }}</div>
            </details>
          </div>
        {%- endif -%}

        {%- if section.settings.accordion_storage != blank -%}
          <div class="product__accordion accordion">
            <details>
              <summary>
                <div class="summary__title">
                  {% render 'icon-accordion', icon: 'box' %}
                  <h2 class="h4 accordion__title">Storage and care</h2>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">{{ section.settings.accordion_storage }}</div>
            </details>
          </div>
        {%- endif -%}

        {%- if section.settings.accordion_contents != blank -%}
          <div class="product__accordion accordion">
            <details>
              <summary>
                <div class="summary__title">
                  {% render 'icon-accordion', icon: 'clipboard' %}
                  <h2 class="h4 accordion__title">Contents</h2>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">{{ section.settings.accordion_contents }}</div>
            </details>
          </div>
        {%- endif -%}

        {%- if section.settings.accordion_ingredients != blank -%}
          <div class="product__accordion accordion">
            <details>
              <summary>
                <div class="summary__title">
                  {% render 'icon-accordion', icon: 'leaf' %}
                  <h2 class="h4 accordion__title">Ingredients</h2>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">{{ section.settings.accordion_ingredients }}</div>
            </details>
          </div>
        {%- endif -%}
      </div>
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.expect_heading != blank -%}
    <div class="sample-duo__band">
      <div class="page-width">
        <h2 class="sample-duo__heading">{{ section.settings.expect_heading }}</h2>
        <div class="sample-duo__expect">
          <article class="sample-duo__card sample-duo__card--hot">
            <div class="sample-duo__card-copy">
              <h3>{{ section.settings.expect_hot_title }}</h3>
              <p>{{ section.settings.expect_hot_text }}</p>
            </div>
            {%- if section.settings.expect_hot_image != blank -%}
              {{
                section.settings.expect_hot_image
                | image_url: width: 600
                | image_tag:
                  class: 'sample-duo__card-sachet',
                  loading: 'lazy',
                  widths: '200, 300, 400, 600',
                  alt: section.settings.expect_hot_title
              }}
            {%- else -%}
              <img
                class="sample-duo__card-sachet"
                src="{{ 'sample-sachet-hot.png' | asset_url }}"
                alt="{{ section.settings.expect_hot_title | escape }}"
                width="280"
                height="280"
                loading="lazy"
              >
            {%- endif -%}
          </article>
          <article class="sample-duo__card sample-duo__card--ice">
            <div class="sample-duo__card-copy">
              <h3>{{ section.settings.expect_ice_title }}</h3>
              <p>{{ section.settings.expect_ice_text }}</p>
            </div>
            {%- if section.settings.expect_ice_image != blank -%}
              {{
                section.settings.expect_ice_image
                | image_url: width: 600
                | image_tag:
                  class: 'sample-duo__card-sachet',
                  loading: 'lazy',
                  widths: '200, 300, 400, 600',
                  alt: section.settings.expect_ice_title
              }}
            {%- else -%}
              <img
                class="sample-duo__card-sachet"
                src="{{ 'sample-sachet-ice.png' | asset_url }}"
                alt="{{ section.settings.expect_ice_title | escape }}"
                width="280"
                height="280"
                loading="lazy"
              >
            {%- endif -%}
          </article>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.steps_heading != blank -%}
    <div class="sample-duo__band">
      <div class="page-width">
        <h2 class="sample-duo__heading">{{ section.settings.steps_heading }}</h2>
        <div class="sample-duo__steps">
          <article class="sample-duo__step">
            <span class="sample-duo__step-num">1</span>
            <h3>{{ section.settings.step_1_title }}</h3>
            <p>{{ section.settings.step_1_text }}</p>
          </article>
          <article class="sample-duo__step">
            <span class="sample-duo__step-num">2</span>
            <h3>{{ section.settings.step_2_title }}</h3>
            <p>{{ section.settings.step_2_text }}</p>
          </article>
          <article class="sample-duo__step">
            <span class="sample-duo__step-num">3</span>
            <h3>{{ section.settings.step_3_title }}</h3>
            <p>{{ section.settings.step_3_text }}</p>
          </article>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.ingredients != blank -%}
    <div class="sample-duo__band">
      <div class="page-width">
        <h2 class="sample-duo__heading">{{ section.settings.ingredients_heading }}</h2>
        <div class="sample-duo__pills">
          {%- for ingredient in ingredients -%}
            {%- assign pill = ingredient | strip -%}
            {%- if pill != blank -%}
              <span class="sample-duo__pill">{{ pill }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- assign reviews = section.blocks | where: 'type', 'review' -%}
  {%- if reviews.size > 0 -%}
    <div class="sample-duo__band sample-duo__band--reviews">
      <div class="page-width">
        <h2 class="sample-duo__heading">{{ section.settings.reviews_heading }}</h2>
        <div class="sample-duo__reviews">
          {%- for block in reviews -%}
            <blockquote class="sample-duo__card" {{ block.shopify_attributes }}>
              <div class="sample-duo__stars" aria-label="5 star rating">
                {{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}
              </div>
              <p class="sample-duo__quote">{{ block.settings.quote }}</p>
              {%- if block.settings.cite != blank -%}
                <p class="sample-duo__cite">{{ block.settings.cite }}</p>
              {%- endif -%}
            </blockquote>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
    <div class="sample-duo__band">
      <div class="page-width">
        <h2 class="sample-duo__heading">{{ section.settings.faq_heading }}</h2>
        <div class="sample-duo__faqs">
          {%- for block in faqs -%}
            <details class="sample-duo__faq" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="sample-duo__faq-answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="sample-duo__sticky">
    <span class="sample-duo__sticky-copy">{{ section.settings.sticky_label }}</span>
    <button
      type="submit"
      class="sample-duo__submit button button--primary"
      form="{{ product_form_id }}"
      {% unless variant.available %}
        disabled
      {% endunless %}
    >
      {{ section.settings.sticky_button }}
    </button>
  </div>

  {% render 'product-media-modal', variant_images: variant_images %}
</section>

{%- if product.media.size > 0 -%}
  <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Sample duo product",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "cite",
          "label": "Attribution"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "dispatch_text",
      "label": "Dispatch note",
      "default": "Dispatched within 1 working day"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "One pack per household"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try both. Just 99p postage."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get one Hot gel sachet and one Ice gel sachet for free. You just cover the 99p postage."
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Just 99p postage"
    },
    {
      "type": "text",
      "id": "hot_title",
      "label": "Hot card title",
      "default": "Hot gel"
    },
    {
      "type": "text",
      "id": "hot_meta",
      "label": "Hot card meta",
      "default": "1 sachet, 5 ml"
    },
    {
      "type": "text",
      "id": "ice_title",
      "label": "Ice card title",
      "default": "Ice gel"
    },
    {
      "type": "text",
      "id": "ice_meta",
      "label": "Ice card meta",
      "default": "1 sachet, 5 ml"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my sample pack"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust point 1",
      "default": "UK made"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust point 2",
      "default": "Lab-tested CBD"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust point 3",
      "default": "Stocked by Boots"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Cosmetic product. Not intended to diagnose, treat, cure or prevent any medical condition. If you are pregnant, breastfeeding or taking medication, speak to a healthcare professional before use."
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "richtext",
      "id": "accordion_usage",
      "label": "Directions and usage",
      "default": "<ul><li>Apply 3-4 times a day and massage until absorbed by skin</li><li>Do not swallow</li><li>Avoid contact with eyes</li><li>Wash hands after use</li><li>If pregnant, always consult your doctor before considering use of any new topical skincare solution</li></ul>"
    },
    {
      "type": "richtext",
      "id": "accordion_storage",
      "label": "Storage and care",
      "default": "<ul><li>Protect from sunlight</li><li>Store in a cool, dry place</li><li>Keep out of reach of children</li><li>Test on a small area of the skin before full application</li></ul>"
    },
    {
      "type": "richtext",
      "id": "accordion_contents",
      "label": "Contents",
      "default": "<p><strong>Ice Muscle and Joint Gel</strong></p><ul><li>CBD 50mg</li><li>No THC (&lt; 0.000025%)</li></ul><p><strong>Hot Muscle and Joint Gel</strong></p><ul><li>CBD 50mg</li><li>No THC (&lt; 0.000025%)</li></ul>"
    },
    {
      "type": "richtext",
      "id": "accordion_ingredients",
      "label": "Ingredients",
      "default": "<p>Ice — Aqua, Alcohol Denat., Glycerin, Menthol, Sodium Polyacrylate, Hydrogenated Polydecene, PEG-35 Castor Oil, Hemp Seed Oil, PEG-8 Dimethicone, Tocopherol (Vitamin E), Diheptyl Succinate, Capryloyl Glycerin/Sebacic Acid Copolymer, Mentha Arvensis Herb Oil (Wild Mint), Mentha Piperita Herb Oil (Peppermint), Trideceth-6, Cannabidiol (CBD), Pinus Sylvestris Twig Leaf Oil (Pine), Laurus Nobilis Leaf Oil (Bay Leaf), Limonene, Linalool, Sodium Chloride, Sodium Sulfate, CI 42090.</p><p>Hot — Aqua, Alcohol Denat., Glycerin, PEG-35 Castor Oil, Sodium Polyacrylate, Menthol, Eugenia Caryophyllus Leaf Oil (Clove Leaf), Hydrogenated Polydecene, Eugenol (Clove Oil), Hemp Seed Oil, PEG-8 Dimethicone, Tocopherol (Vitamin E), Vanillyl Butyl Ether, Diheptyl Succinate, Capryloyl Glycerin/Sebacic Acid Copolymer, Trideceth-6, Cannabidiol (CBD), Eucalyptus Globulus Leaf Oil (Eucalyptus), Limonene, Geraniol, Sodium Chloride, Sodium Sulfate, CI 16255.</p><p><a href=\"/pages/our-ingredients\" title=\"HEMPE product ingredients\">More information on HEMPE product ingredients and their benefits</a>.</p>"
    },
    {
      "type": "header",
      "content": "What to expect"
    },
    {
      "type": "text",
      "id": "expect_heading",
      "label": "Heading",
      "default": "What to expect from each"
    },
    {
      "type": "image_picker",
      "id": "expect_hot_image",
      "label": "Hot sachet image"
    },
    {
      "type": "text",
      "id": "expect_hot_title",
      "label": "Hot title",
      "default": "Hot"
    },
    {
      "type": "textarea",
      "id": "expect_hot_text",
      "label": "Hot text",
      "default": "A gentle warming sensation that helps ease stiffness and get tired muscles moving. Best before activity or when you want heat."
    },
    {
      "type": "image_picker",
      "id": "expect_ice_image",
      "label": "Ice sachet image"
    },
    {
      "type": "text",
      "id": "expect_ice_title",
      "label": "Ice title",
      "default": "Ice"
    },
    {
      "type": "textarea",
      "id": "expect_ice_text",
      "label": "Ice text",
      "default": "A cooling sensation that helps quiet discomfort after activity. Use after exercise or when you want a cold finish."
    },
    {
      "type": "header",
      "content": "How it works"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "Claim your pack"
    },
    {
      "type": "textarea",
      "id": "step_1_text",
      "label": "Step 1 text",
      "default": "Pay just 99p postage. No subscription, no hidden extras."
    },
    {
      "type": "text",
      "id": "step_2_title",
