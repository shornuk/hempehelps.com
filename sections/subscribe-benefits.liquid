{{ 'section-subscribe.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="subscribe subscribe-benefits subscribe-benefits--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="subscribe-benefits__grid">
      <div class="subscribe-benefits__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '450, 600, 900, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="subscribe-benefits__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="subscribe__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="subscribe__subheading">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="subscribe-benefits__list">
            {%- for block in section.blocks -%}
              <li class="subscribe-benefits__item" {{ block.shopify_attributes }}>
                <span class="subscribe-benefits__item-icon">
                  {%- render 'subscribe-icon', icon: block.settings.icon -%}
                </span>
                <div>
                  {%- if block.settings.title != blank -%}
                    <h3 class="subscribe-benefits__item-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="subscribe-benefits__item-text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#choose' }}" class="subscribe__btn subscribe__btn--primary">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Subscribe: benefits",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why subscribe?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Relief works best when it's there when you need it. A HEMPE subscription keeps a fresh gel in your kit bag or bathroom cabinet, at a better price, with none of the admin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe now"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "URL or anchor, e.g. #choose",
      "default": "#choose"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Price tag" },
            { "value": "truck", "label": "Delivery" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "shield", "label": "Shield" },
            { "value": "pause", "label": "Pause" },
            { "value": "skip", "label": "Skip" },
            { "value": "reschedule", "label": "Reschedule" },
            { "value": "refresh", "label": "Change frequency" },
            { "value": "cancel", "label": "Cancel" },
            { "value": "snow", "label": "Ice" },
            { "value": "flame", "label": "Hot" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Short description.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscribe: benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "tag", "title": "Save 10% on every order" } },
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free UK delivery" } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "No commitment" } }
      ]
    }
  ]
}
{% endschema %}
